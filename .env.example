FLASK_ENV=development
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5200
SECRET_KEY=change-me

# Mapbox
MAPBOX_ACCESS_TOKEN=change-me

# Admin credentials
ADMIN_PASSWORD=change-me
ADMIN_API_TOKEN=change-me

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_DEFAULT_SENDER=change-me

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_BOT_USERNAME=change-me

# Auth/CORS
AUTH_TOKEN_EXPIRY_SECONDS=604800
ALLOWED_ORIGINS=http://127.0.0.1:5200,http://localhost:5200
ENABLE_DEBUG_ROUTES=false
SOCKETIO_ASYNC_MODE=threading
SOCKETIO_TRANSPORTS=polling
CSP_ENFORCE=false
